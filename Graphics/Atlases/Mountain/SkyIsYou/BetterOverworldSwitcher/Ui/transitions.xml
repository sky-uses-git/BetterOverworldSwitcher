<Transitions>
	<Transition from="*" to="*">
		<Refs>
			<Anim name="slideOut">
				<Element elem="">
					<Tween value="sclposy" to="1" time="0.5"/>
				</Element>
			</Anim>
			<Anim name="slideIn">
				<Element elem="">
					<Tween value="sclposy" to="0" time="0.5"/>
				</Element>
			</Anim>
		</Refs>
		<From>
			<Ref name="slideOut" type="anim"/>
		</From>
		<To>
			<Anim name="slideIn" type="anim"/>
		</To>
	</Transition>
</Transitions>